# Environment Variables for LIFE.OS Dashboard

# YouTube Data API v3 key (required for YouTube card)
# Get one at: https://console.cloud.google.com → Enable "YouTube Data API v3" → Create API Key
YOUTUBE_API_KEY=your_key_here

# Optional: customize the YouTube search query (default: "AI agents productivity software")
# YOUTUBE_SEARCH_QUERY=AI agents productivity software
